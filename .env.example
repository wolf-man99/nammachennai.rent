# ---------------------------------------------------------------------------
# Chennai.rent environment
#
# Everything here is optional for local development: with no .env at all the app
# runs against a JSON file store so `npm run dev` works on a fresh clone.
# ---------------------------------------------------------------------------

# Postgres / Supabase. Set this and the app switches to the Postgres driver.
# Supabase: Project settings -> Database -> Connection string (session pooler).
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# DATABASE_POOL_MAX=8

# Photo uploads. Without these, uploads fall back to public/uploads, which only
# works on a machine with a writable filesystem (i.e. local development).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=photos

# Admin console at /admin. Unset means the console stays disabled.
# ADMIN_PASSWORD=

# Salt for the non-reversible submitter fingerprint used in abuse detection.
# Set a long random value in production.
# HASH_SALT=

# Canonical URL, used for metadata, sitemap and OpenGraph.
# NEXT_PUBLIC_SITE_URL=https://chennai.rent

# Optional higher-detail basemap. Without it the map uses CARTO Positron, which
# needs no token.
# NEXT_PUBLIC_MAPTILER_KEY=

# Analytics. Events are always written first-party; these add PostHog / GA4.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_GA_ID=
