# ---------------------------------------------------------------------------
# NammaChennai.rent environment
#
# Everything here is optional for local development: with no .env at all the app
# runs against a JSON file store so `npm run dev` works on a fresh clone.
# ---------------------------------------------------------------------------

# --- Data plane: pick ONE -------------------------------------------------
#
# A) REST. Set SUPABASE_URL + SUPABASE_SECRET_KEY below and leave DATABASE_URL
#    empty. No connection string exists anywhere; apply db/schema.sql once from
#    the Supabase SQL editor.
#
# B) Direct Postgres. Set DATABASE_URL and `npm run db:push` handles the schema.
#    Use the TRANSACTION POOLER string (port 6543) - the direct db.* host is
#    IPv6-only and unreachable from most serverless platforms.
#
# DATABASE_URL wins when both are set. With neither, a local JSON file store is
# used so a fresh clone runs with no configuration.

# Postgres / Supabase. Set this and the app switches to the Postgres driver.
# Supabase: Project settings -> Database -> Connection string (session pooler).
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# DATABASE_POOL_MAX=8

# Photo uploads. Without these, uploads fall back to public/uploads, which only
# works on a machine with a writable filesystem (i.e. local development).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_STORAGE_BUCKET=photos
# Either name works. New projects issue sb_secret_... keys; older ones a
# service_role JWT. Both are secret - they bypass RLS.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Admin console at /admin. Unset means the console stays disabled.
# Preferred: a scrypt hash from `npm run admin:hash -- 'your password'`, so the
# plaintext never sits in an environment variable.
# ADMIN_PASSWORD_HASH=scrypt$...$...
# Fallback for local development only:
# ADMIN_PASSWORD=

# Salt for the non-reversible submitter fingerprint used in abuse detection.
# Set a long random value in production.
# HASH_SALT=

# Canonical URL, used for metadata, sitemap and OpenGraph.
# NEXT_PUBLIC_SITE_URL=https://nammachennai.rent

# Optional higher-detail basemap. Without it the map uses CARTO Positron, which
# needs no token.
# NEXT_PUBLIC_MAPTILER_KEY=

# Analytics. Events are always written first-party; these add PostHog / GA4.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# NEXT_PUBLIC_GA_ID=
